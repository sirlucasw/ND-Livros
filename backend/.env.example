# ============================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha
# com seus valores reais
# 
# NUNCA commite o arquivo .env!
# Ele contém senhas e chaves privadas
# ============================================

# MongoDB Connection String
# Local: mongodb://localhost:27017/nd-livros
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/nd-livros

# Porta do servidor
PORT=5000

# Ambiente (development, test, production)
NODE_ENV=development
