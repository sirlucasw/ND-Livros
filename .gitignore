# ============================================
# GITIGNORE - RAIZ DO PROJETO
# ============================================

# Variáveis de ambiente (senhas, URIs, tokens, chaves de API)
.env
.env.*
!.env.example

# Certificados e chaves privadas
*.pem
*.key
*.crt
*.p12
*.pfx

# Credenciais e secrets
*credentials*
*secrets*
config/local*

# Dependências
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Arquivos temporários
*.tmp
*.temp
*.bak

# ============================================
# OBSERVAÇÃO DE SEGURANÇA
# ============================================
# NUNCA commite o arquivo .env ou qualquer arquivo
# que contenha senhas, URIs de banco de dados,
# tokens de API ou chaves privadas.
#
# O backend/.env já está protegido pelo .gitignore
# local em backend/, mas esta regra na raiz garante
# proteção extra caso arquivos .env sejam criados
# em outros locais do projeto.
# ============================================

