# ============================================
# GITIGNORE - RAIZ DO PROJETO
# ============================================

# Variáveis de ambiente (senhas, URIs, tokens, chaves de API)
.env
.env.*
!.env.example

# Certificados e chaves privadas
*.pem
*.key
*.crt
*.p12
*.pfx

# Credenciais e secrets
*credentials*
*secrets*
config/local*

# Dependências
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Arquivos temporários
*.tmp
*.temp
*.bak

# Build e Dist
dist/
build/
*.min.js
*.min.css

# Cache
.npm
.cache
.eslintcache

# Dependências globais
package-lock.json (apenas no .gitignore local se necessário)

# Variáveis de ambiente específicas
.env.local
.env.*.local
.env.development
.env.test
.env.production

# IDE e Editors
*.swp
*.swo
*~
.vscode/settings.json
.vscode/extensions.json
.idea/

# OS Files
.DS_Store
Thumbs.db
*.patch
.AppleDouble
.LSOverride

# Node/npm
npm-debug.log
yarn-error.log
.npm-cache/
yarn.lock (consider committing or add to .gitignore based on preference)

# Arquivos de Debug
.debug
*.mem

# Arquivos de Teste e Coverage
coverage/
.nyc_output/
*.lcov

# Arquivos do MongoDB local
*.db
local_database/
mongo_data/

# Arquivos do Render e Vercel (apenas se gerados localmente)
.vercel/
.render/

# ============================================
# OBSERVAÇÃO DE SEGURANÇA
# ============================================
# NUNCA commite o arquivo .env ou qualquer arquivo
# que contenha senhas, URIs de banco de dados,
# tokens de API ou chaves privadas.
#
# O backend/.env já está protegido pelo .gitignore
# local em backend/, mas esta regra na raiz garante
# proteção extra caso arquivos .env sejam criados
# em outros locais do projeto.
#
# Certifique-se de que .env NUNCA está commitado!
# Se acidentalmente commitou, remova do histórico:
# git rm --cached .env
# git commit --amend --no-edit
# git push -f origin main (cuidado: força push)
# ============================================

